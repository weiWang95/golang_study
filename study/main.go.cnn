	// str := `[[{"0-0":1},{"0-0":1}],[{"1-0":0.15,"1-1":0.20},{"1-0":0.25,"1-1":0.30}],[{"2-0":0.40,"2-1":0.45},{"2-0":0.50,"2-1":0.55}]]`
	str := `[[{"0-0":1},{"0-0":1}],[{"1-0":-0.5721054476390277,"1-1":-0.46755087091787945},{"1-0":-0.5329736437744079,"1-1":-0.4913756590410821}],[{"2-0":-0.06363199284260476,"2-1":0.1065146575005043},{"2-0":-0.029598110502963543,"2-1":-0.013960283371342593}]]`
