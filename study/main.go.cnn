			if (x-y < 0.10 && x-y > -0.10) || (x < 0.5 || y < 0.5) {
				continue
			}
			if y > x {
				data = append(data, []float64{x, y, 0.99, 0.01})
			} else {
				data = append(data, []float64{x, y, 0.01, 0.99})
			}
		}
		// 	if y > x {
		// 		aData = append(aData, []float64{x, y, 0.99, 0.01})
		// 	} else {
		// 		bData = append(bData, []float64{x, y, 0.01, 0.99})
		// 	}
		// }
