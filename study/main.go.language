type Lang struct {
	Key   string `json:"key"`
	Title string `json:"title"`
}

type Lang2 struct {
	Code   string `json:"code"`
	Name   string `json:"name"`
	ZhName string `json:"zh_name"`
	EnName string `json:"en_name"`
}

type Lang3 struct {
	Name       string `json:"name"`
	NativeName string `json:"nativeName"`
}

func main() {
	var d1 []Lang
	json.Unmarshal([]byte(s1), &d1)
	// enNameMap := make(map[string]string, len(d1))
	// for _, item := range d1 {
	// 	enNameMap[item.Key] = item.Title
	// }

	// var d2 []Lang
	// json.Unmarshal([]byte(s2), &d2)
	// zhNameMap := make(map[string]string, len(d2))
	// for _, item := range d2 {
	// 	zhNameMap[item.Key] = item.Title
	// }

	// var d3 map[string]Lang3
	// json.Unmarshal([]byte(s3), &d3)
	// nameMap := make(map[string]string, len(d3))
	// for k, item := range d3 {
	// 	nameMap[k] = item.NativeName
	// }

	// out := make([]Lang2, 0, len(d1))
	// for k, v := range enNameMap {
	// 	name := nameMap[k]
	// 	if name == "" {
	// 		name = nameMap[k[0:2]]
	// 	}

	// 	out = append(out, Lang2{
	// 		Code:   k,
	// 		Name:   name,
	// 		ZhName: zhNameMap[k],
	// 		EnName: v,
	// 	})
	// }

	var d4 []Lang2
	json.Unmarshal([]byte(s4), &d4)
	langMap := make(map[string]Lang2, len(d4))
	for _, item := range d4 {
		langMap[item.Code] = item
	}

	out := make([]Lang2, 0, len(d1))
	for _, item := range d1 {
		out = append(out, langMap[item.Key])
	}

	bs, _ := json.Marshal(out)
	fmt.Println(string(bs))

}

