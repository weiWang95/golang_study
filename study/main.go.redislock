package main

import (
	"context"
	"fmt"
	"sync"

	"github.com/go-redis/redis/v8"
	"winse.com/study/redislock"
)

func main() {
	ctx := context.TODO()
	rds := redis.NewClient(&redis.Options{
		Network:      "tcp",
		Addr:         "localhost:6379",
		PoolSize:     50,
		MinIdleConns: 50,
	})

	wg := sync.WaitGroup{}

	for i := 0; i < 4; i++ {
		wg.Add(1)
		go func(i int) {
			defer wg.Done()

			lock(ctx, rds, i)
		}(i)

	}

	wg.Wait()

	fmt.Println("done")
}

func lock(ctx context.Context, rds *redis.Client, i int) {
	locker := redislock.NewLocker(rds)

	func() {
		key := "test_lock"
		fmt.Println("try lock ", i)
		if err := locker.Lock(ctx, key); err != nil {
			fmt.Println("err -> ", err)
		}
		fmt.Println("locked ", i)
		defer func() {
			err := locker.Unlock(ctx, key)
			fmt.Println("unlock err -> ", err)
		}()
	}()
}
