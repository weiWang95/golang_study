package main

import (
	"bytes"
	"context"
	"encoding/json"
	"fmt"
	"io/ioutil"
	"time"

	"github.com/elastic/go-elasticsearch/v8"
	"github.com/elastic/go-elasticsearch/v8/esutil"
	"github.com/elastic/go-elasticsearch/v8/typedapi/core/search"
	"github.com/elastic/go-elasticsearch/v8/typedapi/types"
	"github.com/elastic/go-elasticsearch/v8/typedapi/types/enums/sortorder"
	"github.com/pkg/errors"
	"github.com/sirupsen/logrus"
	"github.com/spf13/cast"
)

const Index = "organization_org_store"

func main() {
	logrus.SetLevel(logrus.DebugLevel)

	ctx := context.Background()
	if err := TestEs(ctx); err != nil {
		panic(err)
	}
	// if err := TestIndexer(ctx); err != nil {
	// 	panic(err)
	// }
}

func TestEs(ctx context.Context) error {
	es, err := elasticsearch.NewTypedClient(elasticsearch.Config{})
	if err != nil {
		return errors.WithStack(err)
	}

	from := 0
	size := 10
	sort := types.Sort{
		types.SortOptions{
			SortOptions: map[string]types.FieldSort{
				"created_at": {
					Order: &sortorder.Desc,
				},
			},
		},
	}

	r, err := es.Search().Index(Index).Request(&search.Request{
		Query: &types.Query{
			// MatchAll: &types.MatchAllQuery{},
			// Match: map[string]types.MatchQuery{
			// 	// "store_name": {Query: "1testIndexer"},
			// },
			Term: map[string]types.TermQuery{
				"organization_id": {Value: "340016301785229480"},
			},
			// Terms: &types.TermsQuery{
			// 	TermsQuery: map[string]types.TermsQueryField{
			// 		"_id": []uint64{356996345971614499},
			// 	},
			// },
		},
		Sort: sort,
		From: &from,
		Size: &size,
	}).Do(ctx)
	if err != nil {
		return errors.WithStack(err)
	}

	for _, hit := range r.Hits.Hits {
		fmt.Println(hit.Id_)
	}

	return nil
}

func TestIndexer(ctx context.Context) error {
	cli, err := elasticsearch.NewClient(elasticsearch.Config{
		EnableDebugLogger: true,
	})
	if err != nil {
		return errors.WithStack(err)
	}

	indexer, err := esutil.NewBulkIndexer(esutil.BulkIndexerConfig{
		Client:        cli,
		DebugLogger:   logrus.WithField("target", "indexer"),
		Index:         Index,
		FlushInterval: 100 * time.Millisecond,
		OnError: func(ctx context.Context, err error) {
			fmt.Printf("%v\n", err)
		},
	})
	if err != nil {
		return errors.WithStack(err)
	}

	bs, err := ioutil.ReadFile("data.json")
	if err != nil {
		return errors.WithStack(err)
	}
	var data []map[string]interface{}
	if err := json.Unmarshal(bs, &data); err != nil {
		return errors.WithStack(err)
	}

	for _, item := range data {
		if err := indexer.Add(ctx, esutil.BulkIndexerItem{
			Action:     "update",
			DocumentID: cast.ToString(item["id"]),
			Body:       bytes.NewReader([]byte(`{ "doc": { "store_name": "` + item["store_name"].(string) + `testIndexer" }}`)),
			OnSuccess: func(ctx context.Context, bii esutil.BulkIndexerItem, biri esutil.BulkIndexerResponseItem) {
				fmt.Printf("success: %s\n", bii.DocumentID)
			},
			OnFailure: func(ctx context.Context, bii esutil.BulkIndexerItem, biri esutil.BulkIndexerResponseItem, err error) {
				fmt.Printf("fail: %v\n", err)
			},
		}); err != nil {
			return errors.WithStack(err)
		}
	}

	fmt.Printf("%+v\n", indexer.Stats())

	time.Sleep(2 * time.Second)

	fmt.Printf("%+v\n", indexer.Stats())

	if err := indexer.Close(ctx); err != nil {
		return errors.WithStack(err)
	}

	return nil
}
